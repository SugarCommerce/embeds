{
  "name": "sugarcommerce/embeds",
  "description": "Turn a URL somebody pasted into an embed you can safely put in an iframe. A closed list of platforms, exact host matching, and a src rebuilt from validated parts rather than the string that arrived. Zero dependencies.",
  "version": "1.1.0",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/embeds",
  "authors": [ { "name": "David Sherlock", "homepage": "https://arraypress.com/" } ],
  "keywords": ["embed", "oembed", "iframe", "youtube", "vimeo", "soundcloud", "spotify", "bandcamp", "social"],
  "require": { "php": ">=8.5" },
  "require-dev": { "phpunit/phpunit": "^13.0" },
  "autoload": { "psr-4": { "SugarCommerce\\Embeds\\": "src/" } },
  "autoload-dev": { "psr-4": { "SugarCommerce\\Embeds\\Tests\\": "tests/" } },
  "scripts": { "test": "phpunit" },
  "config": { "optimize-autoloader": true, "sort-packages": true, "preferred-install": "dist" },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": { "issues": "https://github.com/sugarcommerce/embeds/issues", "source": "https://github.com/sugarcommerce/embeds" }
}
