{
    "name": "sugarcommerce/embeds",
    "description": "Turn a URL somebody pasted into a WordPress page into a player you can safely frame: a closed list of platforms, exact host matching, a src rebuilt from validated parts, the iframe escaped, and every platform's mark as an icon.",
    "homepage": "https://github.com/SugarCommerce/embeds",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "David Sherlock",
            "homepage": "https://arraypress.com/"
        }
    ],
    "keywords": [
        "wordpress",
        "embed",
        "iframe",
        "youtube",
        "vimeo",
        "soundcloud",
        "spotify",
        "bandcamp",
        "social-icons"
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^3.13.5",
        "wp-coding-standards/wpcs": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "SugarCommerce\\Embeds\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCommerce\\Embeds\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "/tests/bootstrap.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "format": "phpcbf --standard=phpcs-format.xml.dist",
        "format:check": "phpcs --standard=phpcs-format.xml.dist"
    },
    "support": {
        "issues": "https://github.com/SugarCommerce/embeds/issues",
        "source": "https://github.com/SugarCommerce/embeds"
    }
}
